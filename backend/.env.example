# --- App ---
APP_ENV=development
LOG_FORMAT=json
CORS_ORIGINS=http://localhost:5173

# --- Database (PostgreSQL) ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=keicy
DB_USER=keicy
DB_PASSWORD=keicy
# Optional: a full URL here overrides the five values above.
# DATABASE_URL=

# --- AI gateway ---
# Providers tried in order; ones without an API key are skipped. Options: anthropic, openai.
LLM_PROVIDERS=anthropic
LLM_TIMEOUT_S=60
LLM_MAX_RETRIES=2
LLM_RETRY_BACKOFF_S=1

# Claude (Anthropic) — get a key at https://platform.claude.com/settings/keys
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
# Reasoning depth: low | medium | high | xhigh | max
ANTHROPIC_EFFORT=medium
# Optional second provider
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5

# --- PayPal (Sandbox) ---
# Create a sandbox app at https://developer.paypal.com/dashboard/applications/sandbox
# sandbox | live  (always real PayPal REST APIs)
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_CURRENCY=USD
# Webhook ID from Apps & Credentials → your app → Webhooks (needs a public URL, e.g. a tunnel, pointing at
# https://<host>/api/v1/payments/webhook). Without it webhooks are refused; checkout still works.
PAYPAL_WEBHOOK_ID=
PAYPAL_TIMEOUT_S=30

# --- Procurement policy ---
APPROVAL_THRESHOLD=5000
# Tax applied to purchase-order subtotals (0.0825 = 8.25%). 0 = no tax.
TAX_RATE=0

# --- Auth ---
# Required in production. Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
ACCESS_TOKEN_MINUTES=480
# Quick sign-in buttons for the seeded demo accounts (always off when APP_ENV=production).
DEMO_ACCOUNTS_ENABLED=true
