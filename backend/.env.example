# --- App ---
APP_ENV=development
LOG_FORMAT=json
CORS_ORIGINS=http://localhost:5173

# --- Database (PostgreSQL) ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=keicy
DB_USER=keicy
DB_PASSWORD=keicy
# Optional: a full URL here overrides the five values above.
# DATABASE_URL=

# --- AI gateway ---
# Providers tried in order; ones without an API key are skipped. Options: anthropic, openai, ollama.
LLM_PROVIDERS=anthropic,ollama
LLM_TIMEOUT_S=60
LLM_MAX_RETRIES=2
LLM_RETRY_BACKOFF_S=1

# Cloud LLMs — leave keys empty to run fully on Ollama.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5

# Ollama (local fallback) — any model from `ollama list`
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1
OLLAMA_TIMEOUT_S=180
# Reasoning models (qwen3.x etc.) are several times faster with thinking off.
OLLAMA_THINK=false

# --- PayPal (Sandbox) ---
# Create a sandbox app at https://developer.paypal.com/dashboard/applications/sandbox
# sandbox | live  (always real PayPal REST APIs)
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_CURRENCY=USD
# Webhook ID from Apps & Credentials → your app → Webhooks (needs a public URL, e.g. a tunnel, pointing at
# https://<host>/api/v1/payments/webhook). Without it webhooks are refused; checkout still works.
PAYPAL_WEBHOOK_ID=
PAYPAL_TIMEOUT_S=30

# --- Procurement policy ---
APPROVAL_THRESHOLD=5000
# Tax applied to purchase-order subtotals (0.0825 = 8.25%). 0 = no tax.
TAX_RATE=0

# --- Auth ---
# Required in production. Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
ACCESS_TOKEN_MINUTES=480
# Quick sign-in buttons for the seeded demo accounts (always off when APP_ENV=production).
DEMO_ACCOUNTS_ENABLED=true
